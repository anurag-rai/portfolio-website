---
import { navLinks } from "../data/navigation";
---

<div id="mobile-menu" class="fixed inset-0 z-[60] flex flex-col items-center justify-center bg-[var(--bg)] opacity-0 pointer-events-none md:hidden">
  <ul class="flex flex-col items-center gap-8">
    {navLinks.map(({ label, href }) => (
      <li>
        <a href={href} class="mobile-nav-link text-3xl font-[600] text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors duration-300 inline-block opacity-0 translate-y-4">{label}</a>
      </li>
    ))}
  </ul>
</div>

<script>
  import { gsap } from "gsap";

  const menu = document.getElementById("mobile-menu");
  const toggle = document.getElementById("menu-toggle");
  const burgerTop = document.getElementById("burger-top");
  const burgerMid = document.getElementById("burger-mid");
  const burgerBot = document.getElementById("burger-bot");
  const links = document.querySelectorAll(".mobile-nav-link");
  let isOpen = false;

  function openMenu() {
    isOpen = true;
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    if (menu) {
      menu.style.opacity = "1";
      menu.style.pointerEvents = "auto";
    }
    gsap.to(burgerTop, { rotation: 45, y: 5, duration: 0.3 });
    gsap.to(burgerMid, { opacity: 0, duration: 0.2 });
    gsap.to(burgerBot, { rotation: -45, y: -5, duration: 0.3 });
    gsap.to(links, { opacity: 1, y: 0, duration: 0.4, stagger: 0.08, ease: "power2.out", delay: 0.1 });
  }

  function closeMenu() {
    isOpen = false;
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    gsap.to(burgerTop, { rotation: 0, y: 0, duration: 0.3 });
    gsap.to(burgerMid, { opacity: 1, duration: 0.2 });
    gsap.to(burgerBot, { rotation: 0, y: 0, duration: 0.3 });
    gsap.to(links, { opacity: 0, y: 16, duration: 0.2 });
    setTimeout(() => {
      if (menu) {
        menu.style.opacity = "0";
        menu.style.pointerEvents = "none";
      }
    }, 300);
  }

  // Hamburger toggle
  if (toggle) {
    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      isOpen ? closeMenu() : openMenu();
    });
  }

  // Nav links — close menu then scroll
  links.forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const href = (link as HTMLAnchorElement).getAttribute("href");
      closeMenu();
      setTimeout(() => {
        if (href) {
          const target = document.querySelector(href);
          if (target) target.scrollIntoView({ behavior: "smooth" });
        }
      }, 350);
    });
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) closeMenu();
  });

  // Close on click outside (clicking the dark overlay)
  menu?.addEventListener("click", (e) => {
    if (e.target === menu) closeMenu();
  });
</script>
