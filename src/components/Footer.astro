---
import Clock from "./Clock.astro";
import FooterGrass from "./FooterGrass.astro";
import { theme } from "../config/theme";
const { typography } = theme;
---

<footer class="px-6 pb-8 pt-4 lg:px-12 xl:px-24">
  <FooterGrass />
  <div class="h-px mb-8" style="background: var(--gradient-earth);"></div>
  <div class="mx-auto max-w-5xl flex items-center justify-between">
    <!-- Year is set at build time. Redeploy to update. -->
    <span class={`${typography.caption} text-[var(--text-dim)]`}>© {new Date().getFullYear()} Anurag Rai</span>
    <Clock />
  </div>
</footer>
