<div id="preloader" class="fixed inset-0 z-[9999] flex items-center justify-center bg-[var(--bg)]">
  <span
    id="preloader-counter"
    class="text-[clamp(3rem,8vw,6rem)] font-[800] tracking-[-2px] text-[var(--text-primary)]"
  >
    0
  </span>
</div>

<script>
  import { gsap } from "gsap";

  const preloader = document.getElementById("preloader");
  const counter = document.getElementById("preloader-counter");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (prefersReducedMotion) {
    preloader?.remove();
    window.dispatchEvent(new CustomEvent("preloader-complete"));
  } else {
    // Track real asset loading progress
    const assets: Array<{ name: string; loaded: boolean }> = [];
    let progress = 0;
    let displayProgress = 0;
    const MIN_DURATION_MS = 2000; // minimum time to show preloader
    const startTime = performance.now();

    function registerAsset(name: string): () => void {
      const asset = { name, loaded: false };
      assets.push(asset);
      return () => {
        asset.loaded = true;
        updateProgress();
      };
    }

    function updateProgress() {
      const loaded = assets.filter((a) => a.loaded).length;
      progress = assets.length > 0 ? (loaded / assets.length) * 100 : 100;
    }

    // --- Register real assets to track ---

    // 1. Manrope font
    const fontDone = registerAsset("font");
    if (document.fonts) {
      document.fonts.ready.then(fontDone);
    } else {
      fontDone(); // fallback: mark done immediately
    }

    // 2. All images on the page
    const images = document.querySelectorAll("img");
    if (images.length === 0) {
      // No images yet, register a placeholder that completes instantly
      registerAsset("images")();
    } else {
      images.forEach((img, i) => {
        const done = registerAsset(`image-${i}`);
        if (img.complete) {
          done();
        } else {
          img.addEventListener("load", done);
          img.addEventListener("error", done); // don't block on broken images
        }
      });
    }

    // 3. Window full load (scripts, stylesheets, etc.)
    const windowDone = registerAsset("window");
    if (document.readyState === "complete") {
      windowDone();
    } else {
      window.addEventListener("load", windowDone);
    }

    // 4. Three.js scene (listen for custom event from HeroScene)
    const threeDone = registerAsset("three-scene");
    window.addEventListener("hero-scene-ready", () => threeDone());
    // Timeout fallback: if Three.js doesn't load in 5s, don't block
    setTimeout(threeDone, 5000);

    // --- Animate counter to match real progress ---
    let readyToFinish = false;

    function animateCounter() {
      const elapsed = performance.now() - startTime;
      const minProgress = Math.min((elapsed / MIN_DURATION_MS) * 90, 90); // ramp to 90% over min duration

      // Target is the higher of real progress or time-based minimum
      const target = Math.max(progress, minProgress);

      // Once all assets loaded + min time elapsed, race to 100 fast
      if (progress >= 100 && elapsed >= MIN_DURATION_MS) {
        readyToFinish = true;
      }

      if (readyToFinish) {
        // Fast lerp to 100, then finish
        displayProgress += (100 - displayProgress) * 0.25;
        if (counter) counter.textContent = Math.round(displayProgress).toString();

        if (displayProgress > 99.5) {
          if (counter) counter.textContent = "100";
          finishPreloader();
          return;
        }
      } else {
        // Normal smooth approach
        displayProgress += (target - displayProgress) * 0.08;
        if (counter) counter.textContent = Math.round(displayProgress).toString();
      }

      requestAnimationFrame(animateCounter);
    }

    function finishPreloader() {
      gsap.to(preloader, {
        yPercent: -100,
        duration: 0.8,
        ease: "power3.inOut",
        onComplete: () => {
          preloader?.remove();
          window.dispatchEvent(new CustomEvent("preloader-complete"));
        },
      });
    }

    requestAnimationFrame(animateCounter);
  }
</script>
