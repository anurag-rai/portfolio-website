---
import { theme } from "../config/theme";
const { toastMessage } = theme.grass;
---

<div class="relative">
  <canvas
    id="footer-grass"
    class="w-full block cursor-pointer"
    data-toast-message={toastMessage}
  ></canvas>
</div>

<script>
  import { initGrass } from "../scripts/grass";
  import { showToast } from "../scripts/toast";

  const LEAF_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--accent)"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/></svg>`;

  const canvas = document.getElementById("footer-grass") as HTMLCanvasElement | null;

  if (canvas) {
    const message = canvas.dataset.toastMessage || "Finally touching grass, huh?";
    canvas.addEventListener("click", () => showToast(message, LEAF_ICON));
    initGrass(canvas);
  }
</script>
