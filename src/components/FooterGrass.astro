---
import { theme } from "../config/theme";
const { toastMessage } = theme.grass;
const { holdDurationMs } = theme.toast;
---

<div class="relative">
  <canvas
    id="footer-grass"
    class="w-full block cursor-pointer"
    data-hold-duration={holdDurationMs}
  ></canvas>
</div>

<!-- Grass toast -->
<div
  id="grass-toast"
  aria-live="polite"
  class="fixed left-1/2 z-[9999] pointer-events-none"
  style="top: 2rem; transform: translateX(-50%) translateY(-20px) scale(0.9); opacity: 0; transition: none;"
>
  <div
    class="relative flex items-center gap-2 px-5 py-3 rounded-full border border-[var(--accent-sage)] bg-[var(--bg)]"
    style="box-shadow: 0 0 30px rgba(107,112,92,0.2), 0 0 60px rgba(107,112,92,0.1);"
  >
    <svg class="w-4 h-4 text-[var(--accent-sage)]" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>
    </svg>
    <span class="text-sm font-[500] text-[var(--accent-sage)] whitespace-nowrap">{toastMessage}</span>
    <div
      id="grass-toast-ring"
      class="absolute inset-0 rounded-full border border-[var(--accent-sage)]"
      style="opacity: 0; transform: scale(1);"
    >
    </div>
  </div>
</div>

<script>
  import { initGrass } from "../scripts/grass";
  import { theme } from "../config/theme";

  const canvas = document.getElementById("footer-grass") as HTMLCanvasElement | null;
  const toast = document.getElementById("grass-toast");
  const ring = document.getElementById("grass-toast-ring");
  const holdDurationMs = Number(canvas?.dataset.holdDuration) || theme.toast.holdDurationMs;

  let toastTimer: number;

  function showGrassToast() {
    if (!toast || !ring) return;
    clearTimeout(toastTimer);

    toast.style.transition = "none";
    toast.style.transform = "translateX(-50%) translateY(-20px) scale(0.9)";
    toast.style.opacity = "0";
    ring.style.transition = "none";
    ring.style.opacity = "0";
    ring.style.transform = "scale(1)";

    toast.offsetHeight;

    toast.style.transition =
      "opacity 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)";
    toast.style.opacity = "1";
    toast.style.transform = "translateX(-50%) translateY(0) scale(1)";

    setTimeout(() => {
      ring.style.transition = "opacity 0.5s ease-out, transform 0.5s ease-out";
      ring.style.opacity = "0.5";
      ring.style.transform = "scale(1.6)";
      setTimeout(() => {
        ring.style.opacity = "0";
      }, 100);
    }, 150);

    toastTimer = window.setTimeout(() => {
      toast.style.transition = "opacity 0.3s ease-in, transform 0.3s ease-in";
      toast.style.opacity = "0";
      toast.style.transform = "translateX(-50%) translateY(-10px) scale(0.95)";
    }, holdDurationMs);
  }

  if (canvas) {
    canvas.addEventListener("click", showGrassToast);
    initGrass(canvas);
  }
</script>
