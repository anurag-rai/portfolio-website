---
import { profile } from "../data/profile";
const { email, social } = profile;
---

<section id="contact" class="px-6 py-32 lg:px-12 xl:px-24">
  <div class="mx-auto max-w-3xl text-center">
    <h2 data-animate class="text-[clamp(1.75rem,4vw,2.5rem)] font-[700] tracking-[-0.5px] text-[var(--text-primary)] mb-4">Let's Connect</h2>
    <p data-animate class="text-sm leading-relaxed text-[var(--text-muted)] mb-10 max-w-lg mx-auto">I'm always open to discussing new opportunities, interesting projects, or just having a chat about technology.</p>
    <div data-animate>
      <button
        id="copy-email-btn"
        class="magnetic-btn inline-block rounded-md border border-[var(--accent)] px-8 py-3 text-sm font-[500] text-[var(--accent)] transition-all duration-300 hover:bg-[var(--accent)] hover:text-[var(--bg)] cursor-pointer"
      >
        Get In Touch
      </button>
    </div>
    <div data-animate class="mt-12 flex items-center justify-center gap-8">
      <!-- GitHub -->
      <a href={social.github} target="_blank" rel="noopener noreferrer" class="group" aria-label="GitHub">
        <svg class="w-5 h-5 text-[var(--text-dim)] group-hover:text-[var(--accent)] transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <!-- LinkedIn -->
      <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="group" aria-label="LinkedIn">
        <svg class="w-5 h-5 text-[var(--text-dim)] group-hover:text-[var(--accent)] transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <!-- Email -->
      <button id="copy-email-icon" class="group" aria-label="Copy email address">
        <svg class="w-5 h-5 text-[var(--text-dim)] group-hover:text-[var(--accent)] transition-colors duration-300 cursor-pointer" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<!-- Toast: centered pill that rises from the button -->
<div id="email-toast" aria-live="polite" class="fixed left-1/2 z-[9999] pointer-events-none" style="top: 2rem; transform: translateX(-50%) translateY(-20px) scale(0.9); opacity: 0; transition: none;">
  <div class="relative flex items-center gap-2 px-5 py-3 rounded-full border border-[var(--accent)] bg-[var(--bg)]" style="box-shadow: 0 0 30px rgba(203,153,126,0.2), 0 0 60px rgba(203,153,126,0.1);">
    <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
    </svg>
    <span class="text-sm font-[500] text-[var(--accent)] whitespace-nowrap">Email copied to clipboard</span>
    <!-- Expanding ring -->
    <div id="toast-ring" class="absolute inset-0 rounded-full border border-[var(--accent)]" style="opacity: 0; transform: scale(1);"></div>
  </div>
</div>

<script define:vars={{ email }}>
  const toast = document.getElementById("email-toast");
  const ring = document.getElementById("toast-ring");
  let toastTimer;

  async function copyEmail() {
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      const textarea = document.createElement("textarea");
      textarea.value = email;
      textarea.style.cssText = "position:fixed;opacity:0;";
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand("copy");
      document.body.removeChild(textarea);
    }
    showToast();
  }

  function showToast() {
    if (!toast || !ring) return;
    clearTimeout(toastTimer);

    // Reset
    toast.style.transition = "none";
    toast.style.transform = "translateX(-50%) translateY(-20px) scale(0.9)";
    toast.style.opacity = "0";
    ring.style.transition = "none";
    ring.style.opacity = "0";
    ring.style.transform = "scale(1)";

    // Force reflow
    toast.offsetHeight;

    // Animate in — toast rises with bounce feel
    toast.style.transition = "opacity 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)";
    toast.style.opacity = "1";
    toast.style.transform = "translateX(-50%) translateY(0) scale(1)";

    // Ring expands
    setTimeout(() => {
      ring.style.transition = "opacity 0.5s ease-out, transform 0.5s ease-out";
      ring.style.opacity = "0.5";
      ring.style.transform = "scale(1.6)";
      setTimeout(() => {
        ring.style.opacity = "0";
      }, 100);
    }, 150);

    // Fade out after hold
    toastTimer = window.setTimeout(() => {
      toast.style.transition = "opacity 0.3s ease-in, transform 0.3s ease-in";
      toast.style.opacity = "0";
      toast.style.transform = "translateX(-50%) translateY(-10px) scale(0.95)";  // fades up and out
    }, 2000);
  }

  document.getElementById("copy-email-btn")?.addEventListener("click", copyEmail);
  document.getElementById("copy-email-icon")?.addEventListener("click", copyEmail);
</script>
