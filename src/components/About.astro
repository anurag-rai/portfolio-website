---
import { profile } from "../data/profile";
import { skills } from "../data/skills";
const { bio } = profile;
---

<section id="about" class="px-6 py-24 lg:px-12 xl:px-24">
  <div class="mx-auto max-w-5xl">
    <h2 data-animate class="text-[clamp(2rem,4.5vw,2.75rem)] font-[700] tracking-[-0.5px] text-[var(--text-primary)] mb-12">About</h2>
    <div class="flex flex-col gap-12 md:flex-row md:gap-16">
      <div class="flex-1">
        {bio.map((paragraph) => (
          <p data-animate data-split class="text-lg leading-relaxed text-[var(--text-muted)] mb-4">{paragraph}</p>
        ))}
      </div>
      <div class="flex-shrink-0 flex justify-center md:justify-end">
        <div data-animate class="w-32 h-32 rounded-lg bg-[var(--surface)] border border-[var(--border)] flex items-center justify-center text-[var(--text-dim)] text-sm">Photo</div>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="skill-pill rounded px-3 py-1.5 text-sm font-[500] bg-[var(--accent-dark)] text-[var(--text-primary)]">{skill}</span>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { splitTextReveal } from "../scripts/animations";

  gsap.registerPlugin(ScrollTrigger);
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    splitTextReveal("#about [data-split]");
    gsap.fromTo(".skill-pill",
      { opacity: 0, y: 12 },
      {
        opacity: 1, y: 0, duration: 0.4, stagger: 0.05, ease: "power2.out",
        scrollTrigger: { trigger: ".skill-pill", start: "top 85%", end: "bottom 15%", toggleActions: "restart reverse restart reverse" },
      }
    );
  }
</script>
